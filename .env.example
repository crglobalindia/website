# CR Global EXIM - Environment Configuration
# Duplicate this file to '.env' and fill in your keys

# Web3Forms Access Key (Get free key at https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Alternatively, Formspree Endpoint URL (e.g. https://formspree.io/f/xbjnqyzq)
VITE_FORMSPREE_ENDPOINT=

# Primary WhatsApp Business Number (with country code, no + or spaces, e.g. 919876543210)
VITE_WHATSAPP_NUMBER=919876543210

# Primary Export Inquiry Email
VITE_INQUIRY_EMAIL=exports@crglobalexim.com
